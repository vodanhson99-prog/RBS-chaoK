{
  "name": "rbs-chaok",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --prefix api\" \"npm run dev --prefix web\"",
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run dev --prefix api",
    "build": "npm run build --prefix web",
    "start": "node scripts/start-production.mjs",
    "worker:print": "npm run start --prefix worker",
    "backup:data": "node scripts/backup-data.mjs",
    "test:api": "npm test --prefix api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
