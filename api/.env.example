# GESTURE_MIN_CONFIDENCE: 0.05–0.98 (lower = easier to trigger S)
# Web booth polls /api/booth/config every ~1.5s in dev — no browser refresh needed.

GESTURE_HOLD_MS=950
GESTURE_MIN_CONFIDENCE=0.78
GESTURE_CONSECUTIVE_FRAMES=4
COUNTDOWN_SECONDS=3

# Print + ops (Phase 7)
PRINT_CURRENCY=VND
PRINT_PRICE_4X6=50000
PRINT_PRICE_6X8=80000
# Use PAYMENT_MODE=webhook in production with provider verification configured.
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_KEY=
# Replace development values before running with NODE_ENV=production.
PRINT_WORKER_SECRET=dev-print-worker
INTERNAL_API_KEY=dev-internal-key
STORAGE_WARN_BYTES=5368709120

# Operational backup command: npm run backup:data
# Optional: BACKUP_DIR=./backups BACKUP_RETENTION_COUNT=7
